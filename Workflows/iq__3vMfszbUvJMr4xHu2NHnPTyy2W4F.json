{
  "name": "Create MediaRoom",
  "parameters": {
    "admin_group_address": {
      "required": true,
      "type": "string"
    },
    "config_url": {
      "default": "https://main.net955305.contentfabric.io/config",
      "required": false,
      "type": "string"
    },
    "private_key": {
      "required": false,
      "type": "string"
    },
    "room_name": {
      "required": true,
      "type": "string"
    }
  },
  "states": {
    "complete": {
      "job_status_code": 100,
      "prerequisites": {
        "create_private_repository": "complete"
      }
    }
  },
  "steps": {
    "create_mediaroom_group": {
      "action": {
        "action": "manage_group",
        "type": "node-js"
      },
      "configuration": {
        "inputs": {
          "config_url": {
            "class": "parameter",
            "location": "config_url"
          },
          "description": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = \"Contributor for \" + input + \" MediaRoom\""
          },
          "manager_groups": {
            "class": "parameter",
            "location": "admin_group_address",
            "preprocessing": "input = [input]"
          },
          "name": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = input + \" Contributors\""
          },
          "private_key": {
            "class": "parameter",
            "location": "private_key"
          }
        },
        "parameters": {
          "action": "CREATE"
        }
      },
      "name": "Create MediaRoom public access group",
      "prerequisites": {},
      "retries": {
        "exception": {
          "delay": 60,
          "max": 5
        }
      }
    },
    "create_private_library": {
      "action": {
        "action": "manage_library",
        "type": "node-js"
      },
      "configuration": {
        "inputs": {
          "accessor_groups": {
            "class": "parameter",
            "location": "admin_group_address",
            "preprocessing": "input = [input]"
          },
          "config_url": {
            "class": "parameter",
            "location": "config_url"
          },
          "contributor_groups": {
            "class": "parameter",
            "location": "admin_group_address",
            "preprocessing": "input = [input]"
          },
          "description": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = \"Private repository for \" + input + \" MediaRoom\""
          },
          "metadata": {
            "class": "constant",
            "value": {
              "elv": {
                "media": {
                  "drm": {
                    "fps": {
                      "cert": ""
                    }
                  }
                }
              }
            }
          },
          "name": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = input + \" Private MediaRoom\""
          },
          "private_key": {
            "class": "parameter",
            "location": "private_key"
          }
        },
        "parameters": {
          "action": "CREATE"
        }
      },
      "name": "Create MediaRoom private library",
      "prerequisites": {
        "create_mediaroom_group": "complete"
      },
      "retries": {
        "exception": {
          "delay": 60,
          "max": 5
        }
      }
    },
    "create_private_repository": {
      "action": {
        "action": "manage_object",
        "type": "node-js"
      },
      "configuration": {
        "inputs": {
          "config_url": {
            "class": "parameter",
            "location": "config_url"
          },
          "description": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = \"Media repository for \" + input + \" MediaRoom\""
          },
          "editor_groups": {
            "class": "parameter",
            "location": "admin_group_address",
            "preprocessing": "input = [input]"
          },
          "library_id": {
            "class": "output",
            "location": "library_id",
            "step_id": "create_private_library"
          },
          "name": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = input + \" Media Repository\""
          },
          "private_key": {
            "class": "parameter",
            "location": "private_key"
          }
        },
        "parameters": {
          "action": "CREATE"
        }
      },
      "name": "Create media repository in private library",
      "prerequisites": {
        "create_private_library": "complete"
      },
      "retries": {
        "exception": {
          "delay": 60,
          "max": 5
        }
      }
    },
    "create_public_library": {
      "action": {
        "action": "manage_library",
        "type": "node-js"
      },
      "configuration": {
        "inputs": {
          "accessor_groups": {
            "class": "output",
            "location": "group_address",
            "preprocessing": "input = [input]",
            "step_id": "create_mediaroom_group"
          },
          "config_url": {
            "class": "parameter",
            "location": "config_url"
          },
          "contributor_groups": {
            "class": "output",
            "location": "group_address",
            "preprocessing": "input = [input]",
            "step_id": "create_mediaroom_group"
          },
          "description": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = \"Public repository for \" + input + \" MediaRoom\""
          },
          "metadata": {
            "class": "constant",
            "value": {
              "elv": {
                "media": {
                  "drm": {
                    "fps": {
                      "cert": ""
                    }
                  }
                }
              }
            }
          },
          "name": {
            "class": "parameter",
            "location": "room_name",
            "preprocessing": "input = input + \" Public MediaRoom\""
          },
          "private_key": {
            "class": "parameter",
            "location": "private_key"
          }
        },
        "parameters": {
          "action": "CREATE"
        }
      },
      "name": "Create MediaRoom public library",
      "prerequisites": {
        "create_mediaroom_group": "complete"
      },
      "retries": {
        "exception": {
          "delay": 60,
          "max": 5
        }
      }
    }
  }
}