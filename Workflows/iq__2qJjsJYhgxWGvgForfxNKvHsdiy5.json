      "name": "Create video ladder",
      "prerequisites": {
        "#": 1,
        ".": [
          {
            "create_master": "complete"
          },
          {
            "create_master": "failed"
          }
        ]
      },
      "retries": {
        "exception": {
          "delay": 60,
          "max": 5
        }
      }
    },
    "create_master": {
      "action": {
        "action": "create_production_master",
