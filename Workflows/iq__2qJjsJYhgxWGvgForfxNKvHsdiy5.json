    "check_secondary_audio": {
      "action": {
        "action": "test",
        "type": "node-js"
      },
      "configuration": {
        "inputs": {
          "secondary_audio": {
            "class": "parameter",
            "location": "secondary_audio"
          }
        },
        "parameters": {
          "code": "(inputs[\"secondary_audio\"] == true)",
          "variables": {
            "secondary_audio": {
              "type": "boolean"
            }
          }
        }
      },
      "name": "Check if a secondary audio is provided",
      "prerequisites": {
        "#": 1,
        ".": [
          {
            "remove_default_audio": "complete"
          },
          {
            "remove_default_audio": "failed"
          }
        ]
      },
      "retries": {
        "exception": {
          "delay": 30,
          "max": 5
        }
      }
    },
    "create_ladder": {
      "action": {
        "action": "create_ladder",
        "type": "node-js"
      },
      "configuration": {
        "inputs": {
          "config_url": {
            "class": "parameter",
            "location": "config_url"
          },
          "drm_optional": {
            "class": "constant",
            "value": false
