    "abr_profile": {
      "default": null,
      "required": false,
      "type": "object"
    },
    "admin_group": {
      "required": true,
      "type": "string"
    },
    "asset_type": {
      "default": "primary",
      "required": false,
      "type": "string"
    },
    "audio_channel_indexes": {
      "array_item_type": "numeric",
      "required": false,
      "type": "array"
    },
    "audio_mapping": {
      "required": "true",
      "type": "string",
      "values": [
        "",
        "2MONO_1STEREO",
        "2CHANNELS_1STEREO",
        "6MONO_1SURROUND"
      ]
    },
    "audio_stream_indexes": {
      "array_item_type": "numeric",
      "required": true,
      "type": "array"
    },
    "audio_stream_label": {
      "default": "stereo",
      "required": false,
      "type": "string"
    },
    "cloud_access_key_id": {
      "required": true,
      "type": "string"
    },
    "cloud_bucket": {
      "required": true,
      "type": "string"
    },
    "cloud_region": {
      "default": "us-west-2",
      "required": false,
      "type": "string"
    },
    "cloud_secret_access_key": {
      "required": true,
      "type": "string"
    },
    "config_url": {
      "default": "https://main.net955305.contentfabric.io/config",
      "required": false,
      "type": "string"
    },
    "ip_title_id": {
      "required": true,
      "type": "string"
    },
    "master_source_file_paths": {
      "required": true,
      "type": "array"
    },
    "metadata": {
      "required": false,
      "type": "object"
    },
    "mezzanines_lib": {
      "required": true,
      "type": "string"
    },
    "mezzanines_type": {
      "required": true,
      "type": "string"
    },
    "private_key": {
      "default": "0xb8a2aa29791d4c316265a478d89e0aa048602b93b5025c7d06be7c2f2c868a0b",
      "required": false,
      "type": "string"
    },
    "private_key_pool": {
      "default": {
        "cluster_type": "random",
        "cluster_values": [
          "0x34037fb74d2d00ec0f2dacc9d53c61a5565ed41ba4d9dbf1eca228f038bbadfc",
          "0x048ce457ceda7009b8d7342a7bfaaabeb75cb516b5f1b73066900c0f90f2291e",
          "0x1aa9bfd9c994bf6d78b63795b138b38fb47584a1c6b343a39d69956ff3a88af9"
        ]
      },
      "required": false,
      "type": "password"
    },
    "secondary_audio": {
      "default": false,
      "required": false,
      "type": "boolean"
    },
    "secondary_audio_channel_indexes": {
      "array_item_type": "numeric",
      "required": false,
      "type": "array"
    },
    "secondary_audio_mapping": {
      "required": "false",
      "type": "string",
      "values": [
        "",
        "2MONO_1STEREO",
        "2CHANNELS_1STEREO",
        "6MONO_1SURROUND"
      ]
    },
    "secondary_audio_stream_indexes": {
      "array_item_type": "numeric",
      "required": false,
      "type": "array"
    },
    "secondary_audio_stream_label": {
      "default": "surround",
      "required": false,
      "type": "string"
    },
    "title": {
      "required": true,
      "type": "string"
    },
    "title_type": {
      "default": "feature",
