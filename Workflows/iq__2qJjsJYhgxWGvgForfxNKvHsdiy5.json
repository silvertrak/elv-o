          "ip_title_id": {
            "class": "parameter",
            "location": "ip_title_id"
          },
          "master_source_file_paths": {
            "class": "parameter",
            "location": "master_source_file_paths"
          },
          "private_key": {
            "class": "parameter",
            "location": "private_key",
