          "cloud_bucket": {
            "class": "parameter",
            "location": "cloud_bucket"
          },
          "cloud_region": {
            "class": "parameter",
            "location": "cloud_region"
          },
          "cloud_secret_access_key": {
            "class": "parameter",
            "location": "cloud_secret_access_key"
          },
          "config_url": {
            "class": "parameter",
            "location": "config_url"
          },
