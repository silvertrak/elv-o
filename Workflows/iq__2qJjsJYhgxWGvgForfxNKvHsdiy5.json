          },
          "s3_reference": {
            "class": "constant",
            "value": true
          },
          "title": {
            "class": "parameter",
            "location": "title"
          }
        },
        "parameters": {
          "aws_s3": true
        }
      },
      "idle_timeout": 180,
      "name": "Create production master from S3",
      "prerequisites": {
        "create_mezz_object": "complete"
      },
      "retries": {
        "exception": {
          "delay": 60,
          "max": 5
