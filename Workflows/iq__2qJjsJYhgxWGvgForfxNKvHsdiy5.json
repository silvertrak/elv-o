            "class": "constant",
            "value": [
              "dash-widevine",
              "hls-fairplay"
            ]
          },
          "private_key": {
            "class": "parameter",
            "location": "private_key",
            "preprocessing": "input = input || inputs.private_key_pool"
          },
          "private_key_pool": {
            "class": "parameter",
            "location": "private_key_pool"
          }
        },
        "parameters": {
          "input_type": "master_object_id"
        }
